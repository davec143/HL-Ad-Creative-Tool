# HitLights Ad Builder configuration. Copy to .env for local use; on the host, set these as
# environment variables / secrets. Never commit real values.

# ---- server ----
PORT=8080
# The public address people open. Used for the Higgsfield sign-in redirect.
PUBLIC_URL=http://localhost:8080
# Where runs, finished files and the Higgsfield sign-in are stored. Use a persistent volume.
DATA_DIR=./data
# Team password for the page and a long random string that signs session cookies.
# REQUIRED when NODE_ENV=production (the Docker image sets it): APP_PASSWORD >= 10 characters,
# SESSION_SECRET >= 32 characters. Sessions last SESSION_DAYS (default 7).
APP_PASSWORD=
SESSION_SECRET=
SESSION_DAYS=7

# ---- rendering ----
# higgsfield-mcp: Higgsfield's official MCP server (Nano Banana Pro, 2K, subscription credits).
#                 Sign in once from the banner on the page. No API key needed.
# fake:           local placeholder renders for development (no credits).
RENDERER=higgsfield-mcp
# Credit guards. CREDITS_PER_RENDER is an ESTIMATE (Higgsfield doesn't report per-job cost).
# Caps count reserved + spent credits, including repaints and regenerations.
CREDITS_PER_RENDER=2
MAX_CREDITS_PER_RUN=12
MAX_CREDITS_PER_DAY=120
# Reserved for Higgsfield's key-based Cloud API (separate prepaid balance; not used yet).
HIGGSFIELD_API_KEY=

# ---- Shopify catalog (custom app: read_products, read_inventory) ----
SHOPIFY_STORE=hitlights.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10

# ---- copy drafting + text & logo check ----
# Pick one provider. Switching is just changing these variables; nothing else changes.
# openai:             OpenAI API. Set OPENAI_API_KEY. Default: gpt-5.6-luna for both (cheapest; set LLM_QA_MODEL=gpt-5.6-terra for stricter checks).
# anthropic:          Claude API. Set ANTHROPIC_API_KEY. Defaults: claude-haiku-4-5 drafts, claude-sonnet-5-5 checks.
# openai-compatible:  any other Chat Completions endpoint (Gemini, OpenRouter...): set
#                     LLM_BASE_URL, LLM_API_KEY, LLM_DRAFT_MODEL and optionally LLM_QA_MODEL.
# LLM_DRAFT_MODEL / LLM_QA_MODEL override the defaults for any provider.
# none:               both features off.
# Without a language model nothing is auto-delivered (checks off = unchecked).
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_DRAFT_MODEL=
LLM_QA_MODEL=

# Product-fidelity check required for auto-delivery (default on). 0 = deliberately opt out.
REQUIRE_PRODUCT_FIDELITY=1

# ---- operations ----
# Milliseconds to let in-flight work reach a saved state on SIGTERM.
SHUTDOWN_GRACE_MS=20000
# Behind Railway's proxy the client IP is the last X-Forwarded-For hop (auto on Railway).
TRUST_PROXY=

# ---- Google Drive delivery (optional) ----
# Service-account key JSON (one line) and the folder ID it can write to. Share the folder with
# the service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_PARENT=
